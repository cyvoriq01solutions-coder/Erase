{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CYVRA Erase",
  "version": "0.3.0",
  "identifier": "in.co.cyvra.erase",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web && npm run stage:purge-helper",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "CYVRA Erase",
        "width": 1180,
        "height": 760,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "decorations": true,
        "alwaysOnTop": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false,
        "scope": []
      },
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "font-src": "'self'",
        "img-src": "'self' data: blob: asset: http://asset.localhost",
        "media-src": "'self' blob: mediastream:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'",
        "script-src": "'self'",
        "style-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "publisher": "CYVORIQ Solutions",
    "shortDescription": "CYVRA Erase assessment and verification for authorised Windows devices.",
    "longDescription": "CYVRA Erase assesses authorised Windows devices and can sanitise extra disks with Mode S after a bound Purge licence, the PC name, and ERASE. The Windows system disk is never Mode S while this application is running on it. This installer is unsigned until Authenticode signing and the authorised customer download are approved.",
    "copyright": "Copyright CYVORIQ Solutions. All rights reserved.",
    "licenseFile": "LICENSE.installer.txt",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "certificateThumbprint": null,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false,
        "startMenuFolder": "CYVORIQ"
      }
    },
    "resources": {
      "binaries/cyvra-purge-helper.exe": "cyvra-purge-helper.exe"
    }
  }
}
