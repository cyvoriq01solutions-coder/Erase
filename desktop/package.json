{
  "name": "@cyvoriq/cyvra-desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build:web": "vite build",
    "stage:purge-helper": "node scripts/stage-purge-helper.mjs",
    "build": "npm run check && npm test && npm run build:web",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "5.9.3",
    "vite": "8.2.0"
  }
}
