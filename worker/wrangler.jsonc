{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "cyvoriq-erase-api",

  "main": "src/index.ts",

  "compatibility_date": "2026-08-15",

  "workers_dev": true,

  "vars": {
    "APP_ENV": "production",
    "API_VERSION": "v1",

    "AUTH_EMAIL_ENDPOINT": "https://api.resend.com/emails",

    "AUTH_EMAIL_FROM": "CYVORIQ <auth@otp.cyvra.co.in>",

    "PORTAL_ORIGINS": "https://www.cyvra.co.in,https://cyvra.co.in",

    "ADMIN_PORTAL_ORIGIN": "https://admin.cyvra.co.in"
  },

  "hyperdrive": [
  {
    "binding": "HYPERDRIVE",
    "id": "a741ce4f02de4b54a32a6cfb57d9135"
  }
]
}